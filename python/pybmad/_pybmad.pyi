    Parameters
    ----------
    lat : LatStruct
        Lattice of elements.
    
    s : float
        Longitudinal position.
    
    choose_max : bool
        See above
    
    ix_branch : int, optional
        Branch index. Default is 0.
    
    print_err : bool, optional
