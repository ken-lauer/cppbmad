---
Language: Cpp
Standard: Latest

# --- Indentation & Tabs ---
IndentWidth: 2
TabWidth: 2 # Matched to IndentWidth usually prevents alignment desyncs
UseTab: Never
AccessModifierOffset: -2
NamespaceIndentation: None # Was NamespaceIndentation
ColumnLimit: 100
# This forces arguments to break if the line is too long,
# and prevents them from grouping together if they break.
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false # Good addition for call sites
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: MultiLine
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignOperands: Align
AlignTrailingComments: false
AlignEscapedNewlines: Left
AlignAfterOpenBracket: BlockIndent

# --- Includes ---
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*\.h(pp)?>'
    Priority: 1
  - Regex: "^<.*"
    Priority: 2
  - Regex: ".*"
    Priority: 3

# --- Pointers & Casts ---
PointerAlignment: Right
SpaceAfterCStyleCast: false
SpacesInCStyleCastParentheses: false

# --- Spaces ---
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: Never
SpacesInContainerLiterals: true
SpacesInParentheses: false
SpacesInSquareBrackets: false

# --- Breaking ---
BreakConstructorInitializers: BeforeComma
AlwaysBreakTemplateDeclarations: Yes
PackConstructorInitializers: Never

# Miscellaneous
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
PenaltyBreakAssignment: 2 # Prefer breaking assignments slightly more
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 200 # Lowered slightly; sometimes breaking return type is helpful
